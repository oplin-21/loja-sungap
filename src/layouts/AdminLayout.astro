---
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
// Admin's OWN stylesheet — never global.css, which carries the active
// storefront set's tokens and base-layer rules. A dark set would otherwise
// restyle every authenticated Admin page (see src/styles/admin.css).
import '../styles/admin.css';

type Section =
  | 'dashboard'
  | 'products'
  | 'orders'
  | 'customers'
  | 'categories'
  | 'media'
  | 'pages'
  | 'navigation'
  | 'shipping'
  | 'settings';

interface Props {
  title?: string;
  active?: Section;
}

const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
// Nudge to finish first-run setup — except while on the wizard itself.
const showSetupNudge =
  !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
// Show "Log out" only when a password-login session cookie is present. Under
// Cloudflare Access or local dev there's no minshop session to clear.
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} admin` : `${storeName} admin`;
// Configuration that fails closed blocks checkout for physical orders, and the only
// other signal is a Worker log nobody is watching. Surface it on EVERY admin page,
// not just the shipping one — the merchant should not have to go looking to find
// out that they cannot take orders. Resolution is already loaded for this request,
// so this costs no query.
const shippingIssue = shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = await countUnresolvedInventoryExceptions(env.DB);

const nav: { key: Section; label: string; href: string }[] = [
  { key: 'dashboard', label: 'Painel', href: '/admin' },
  { key: 'products', label: 'Produtos', href: '/admin/products' },
  { key: 'orders', label: 'Pedidos', href: '/admin/orders' },
  { key: 'customers', label: 'Clientes', href: '/admin/customers' },
  { key: 'categories', label: 'Categorias', href: '/admin/categories' },
  { key: 'pages', label: 'Páginas', href: '/admin/pages' },
  { key: 'navigation', label: 'Menu da loja', href: '/admin/navigation' },
  { key: 'shipping', label: 'Frete', href: '/admin/shipping' },
  { key: 'media', label: 'Galeria', href: '/admin/media' },
  { key: 'settings', label: 'Configurações', href: '/admin/settings' },
];
// Label of the section we're on — shown in the collapsed mobile disclosure.
const currentLabel = nav.find((n) => n.key === active)?.label ?? 'Menu';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 sm:flex-row sm:gap-10">
      <aside class="w-full shrink-0 sm:w-52 sm:border-r sm:border-line sm:pr-6">
        <a href="/" class="mb-4 block font-serif text-xl tracking-tight sm:mb-8">{storeName}</a>

        {/* Pure-CSS disclosure (a hidden checkbox toggle). On mobile the list is
            collapsed by default and the labelled summary card expands it — no JS,
            and each SSR page load resets it, so it always reflects the page you're
            on. At sm+ the checkbox/summary are hidden and the list is shown inline
            as the vertical sidebar. (We deliberately avoid <details>: Chromium
            doesn't paint closed-<details> content even when CSS forces it visible,
            which blanks the desktop sidebar.) */}
        <input
          type="checkbox"
          id="admin-nav"
          data-admin-nav-toggle
          class="peer sr-only"
          aria-label="Abrir ou fechar menu"
        />
        <label
          for="admin-nav"
          data-admin-nav-summary
          class="flex cursor-pointer select-none items-center justify-between gap-3 rounded-md border border-line bg-white/60 px-4 py-3 transition hover:border-brand sm:hidden"
        >
          <span class="flex flex-col gap-0.5">
            <span class="text-[0.625rem] uppercase tracking-[0.25em] text-gray-400">Administração</span>
            <span class="font-serif text-lg leading-none tracking-tight text-gray-900">{currentLabel}</span>
          </span>
          <svg
            data-admin-nav-chevron
            class="size-4 shrink-0 text-gray-400 transition-transform duration-300"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M5 7.5 10 12.5 15 7.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </label>

        <nav
          data-admin-nav-list
          class="mt-2 hidden overflow-hidden rounded-md border border-line bg-white/60 text-xs uppercase tracking-widest peer-checked:block sm:mt-0 sm:block sm:space-y-0.5 sm:rounded-none sm:border-0 sm:bg-transparent"
        >
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={active === n.key ? 'page' : undefined}
                class={`flex items-center justify-between border-b border-l-2 border-line px-4 py-3 transition last:border-b-0 sm:block sm:border-b-0 sm:px-3 sm:py-1.5 ${
                  active === n.key
                    ? 'border-l-brand bg-paper font-medium text-brand sm:bg-transparent'
                    : 'border-l-transparent text-gray-500 hover:bg-paper hover:text-brand sm:hover:bg-transparent'
                }`}
              >
                <span>{n.label}</span>
                {active === n.key && (
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-brand sm:hidden" />
                )}
              </a>
            ))
          }
        </nav>

        <div class="mt-4 flex gap-4 text-xs uppercase tracking-widest text-gray-400 sm:mt-8 sm:flex-col sm:gap-2">
          <a href="/" class="hover:text-brand">&larr; Ver loja</a>
          {showLogout && <a href="/admin/logout" class="hover:text-brand">Sair</a>}
        </div>
      </aside>

      <main class="min-w-0 flex-1">
        {
          showSetupNudge && (
            <a
              href="/admin/setup"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700 transition hover:border-brand"
            >
              <span>
                <strong class="font-semibold">Termine de configurar sua loja</strong> — nome da loja, pagamentos e mais.
              </span>
              <span aria-hidden="true" class="text-brand">&rarr;</span>
            </a>
          )
        }
        {
          Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && (
            <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
              <strong class="font-semibold">Nenhuma forma de pagamento real configurada.</strong> Só{' '}
              <strong>Pagamento de demonstração</strong> pode receber pedidos agora — eles ficam registrados e marcados como{' '}
              <code class="rounded bg-amber-100 px-1 text-xs">demo</code>. Os clientes veem avisos de configuração até você cadastrar uma chave. A demonstração continua disponível.
            </div>
          )
        }
        {
          shippingIssue && (
            <a
              href="/admin/shipping"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
            >
              <span>
                <strong class="font-semibold">A finalização com frete está bloqueada por configuração inválida:</strong>{' '}
                {shippingIssue.reason}
              </span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
        {
          inventoryExceptionCount > 0 && (
            <a
              href="/admin/orders#inventory-exceptions"
              class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
            >
              <span>
                <strong class="font-semibold">O estoque precisa de atenção.</strong>{' '}
                {inventoryExceptionCount} paid order line{inventoryExceptionCount === 1 ? '' : 's'} chegou depois do fim da reserva de estoque e não pôde ser baixado por completo. Abra os pedidos afetados e acerte o estoque.
              </span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          )
        }
        <slot />
      </main>
    </div>
  </body>
</html>
