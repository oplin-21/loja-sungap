---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getConfig, formatPrice } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { getProductByPublicId, type Product } from '../features/products/db';
import { listVariants, getExtrasByPublicIds, type ProductVariant } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId';
import {
  claimOrderIdentity,
  deleteGuestAccessIfUnsettled,
} from '../features/orders/guestAccess';
import { lineUnitPriceCents } from '../features/cart/key';
import { quoteShipping, allowedCountries, hasCatchAllZone } from '../features/shipping/calculator';
import { countryOptions, countryName, isCountryCode } from '../features/shipping/countries';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { getLightningBackend } from '../features/payments/lightning';
import { mintLightningOrder } from '../features/payments/lightning-provider';
import {
  DEMO_CHECKOUT_TTL_SECONDS,
  isMethodAvailable,
  getPaymentProvider,
} from '../features/payments';
import {
  reserveInventory,
  releaseInventoryReservation,
} from '../features/orders/reservations';
import { reservationItems } from '../features/orders/reservationItems.ts';
import { purgeStockProductCache } from '../features/cache/purge';
import { getSecret } from '../features/secrets/store';
import { getSetting } from '../features/settings/db';
import { cotarFrete } from '../features/br/melhorEnvio';
import {
  UFS,
  documentoValido,
  formataDocumento,
  cepValido,
  formataCep,
  telefoneValido,
  ufValida,
} from '../features/br/documento';

const cfg = getConfig();
const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (name: string) => (form?.get(name) ?? '').toString().trim();

/**
 * The in-app shipping checkout, shared by every rail that cannot collect a
 * destination on its own hosted page: Lightning has no hosted page at all,
 * OpenNode's ignores addresses, and Demo has none. Stripe skips this — it collects
 * the address itself, after the session is created.
 *
 * Gate on the chosen rail being AVAILABLE (configured), not on it being the
 * default, so the method picker can route here whatever the store's default is.
 * The rail arrives as a query param on the first hop and as a hidden field across
 * the address → shipping steps (the forms post to a bare /checkout).
 */
const IN_APP_RAILS = ['infinitepay', 'lightning', 'opennode', 'demo'] as const;
type InAppRail = (typeof IN_APP_RAILS)[number];
const requestedRail = (fld('method') || Astro.url.searchParams.get('method') || '').trim();
const rail: InAppRail = (IN_APP_RAILS as readonly string[]).includes(requestedRail)
  ? (requestedRail as InAppRail)
  : 'infinitepay';
if (!Astro.locals.settings || !isMethodAvailable(rail, Astro.locals.settings))
  return Astro.redirect('/cart', 303);

// Order lines: buy-now (product_id [+ variant/extras]) or the whole cart. All
// selectors arrive as prefixed public IDs (prod_/var_/xtra_ — api/checkout.ts
// routes here with them); numeric row IDs are never accepted.
const productPublicId = parsePublicId(
  fld('product_id') || (Astro.url.searchParams.get('product_id') ?? ''),
  'product',
);
// Express buy-now carries variant + extras — in the query on the first hop, then
// as hidden fields across the address → shipping steps.
const buyNowVariantId = parsePublicId(
  fld('variant_id') || Astro.url.searchParams.get('variant_id') || '',
  'variant',
);
const buyNowExtraIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
  .map((e) => parsePublicId(e, 'extra'))
  .filter((x): x is string => x !== null);

interface CheckoutLine {
  product: Product;
  qty: number;
  name: string;
  unitPriceCents: number;
  variantId: number | null;
  /** Carried (not just its id) because shipment weight needs the variant's own
   *  weight, which overrides the product's. */
  variant: ProductVariant | null;
}
let lines: CheckoutLine[] = [];
if (productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (product && product.active) {
    const variants = await listVariants(env.DB, product.id);
    const variant =
      variants.length > 0 && buyNowVariantId
        ? (variants.find((v) => v.public_id === buyNowVariantId) ?? null)
        : null;
    const extras = buyNowExtraIds.length
      ? await getExtrasByPublicIds(env.DB, product.id, buyNowExtraIds)
      : [];
    lines = [
      {
        product,
        qty: 1,
        name:
          product.name +
          (variant ? ` — ${variant.label}` : '') +
          (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''),
        unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
        variantId: variant?.id ?? null,
        variant,
      },
    ];
  }
} else {
  const { lines: cartLines } = await resolveCart(env.DB, readCart(Astro.cookies));
  lines = cartLines.map((l) => ({
    product: l.product,
    qty: l.qty,
    name:
      l.product.name +
      (l.variant ? ` — ${l.variant.label}` : '') +
      (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    unitPriceCents: l.unitPriceCents,
    variantId: l.variant?.id ?? null,
    variant: l.variant,
  }));
}
if (lines.length === 0) return Astro.redirect('/cart', 303);

const subtotalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const currency = cfg.currency;
const effectiveShipping = shippingFor(Astro.locals.settings).config;
const knownCountries = allowedCountries(effectiveShipping);
const shipsAnywhere = hasCatchAllZone(effectiveShipping);
// Cloudflare's GeoIP country (the CF-IPCountry request header): the default
// destination when it's one we ship to. A guess, so it only seeds the selector —
// the shopper can always change it. 'XX'/'T1' fail isCountryCode and fall through.
const geoCountry = String(Astro.request.headers.get('cf-ipcountry') ?? '').toUpperCase();
const geoDefault =
  isCountryCode(geoCountry) && (shipsAnywhere || knownCountries.includes(geoCountry))
    ? geoCountry
    : null;
// The choices the address form offers: every shippable country, by name. Explicit
// zones list their codes; a catch-all store offers the whole ISO list.
const destinationChoices = shipsAnywhere
  ? countryOptions()
  : knownCountries.map((code) => ({ code, name: countryName(code) })).sort((a, b) =>
      a.name.localeCompare(b.name),
    );
// Weight (and whether shipping applies at all) always comes from the current D1
// rows resolved above — never from the posted form.
const shipment = shipmentWeightFor(lines);
const carry = productPublicId ?? '';
const carryVariantId = buyNowVariantId ?? '';
const carryExtraIds = buyNowExtraIds;

const editAddressHref = (() => {
  const params = new URLSearchParams({ method: rail });
  if (carry) params.set('product_id', carry);
  if (carryVariantId) params.set('variant_id', carryVariantId);
  for (const id of carryExtraIds) params.append('extra', id);
  return `/checkout?${params}`;
})();
const RAIL_LABEL: Record<InAppRail, string> = {
  infinitepay: 'Ir para o pagamento (Pix ou cartão)',
  lightning: 'Pagar com Lightning',
  opennode: 'Pagar com Bitcoin',
  demo: 'Fazer pedido de demonstração',
};

/**
 * Demo orders don't ship anywhere, so the demo rail skips this page entirely:
 * the first GET is treated as a submission of this hard-coded sample address
 * with the first quoted rate, and the shopper lands straight on /pay — one
 * click (Approve) end to end, with the demo banner as the first thing they
 * see. The form only renders for demo in the error fallback (e.g. shipping
 * cannot be quoted). The real-money rails (Lightning/OpenNode) always type.
 */
const DEMO_ADDRESS = {
  email: 'demo@example.com',
  name: 'Cliente Demonstração',
  phone: '(11) 99999-0000',
  document: '529.982.247-25',
  line1: 'Avenida Paulista',
  number: '1000',
  line2: '',
  district: 'Bela Vista',
  city: 'São Paulo',
  state: 'SP',
  postal: '01310-100',
  country: 'BR',
};
const prefill = rail === 'demo' && !isPost ? DEMO_ADDRESS : null;
const addr = {
  email: fld('email') || (prefill?.email ?? ''),
  name: fld('name') || (prefill?.name ?? ''),
  phone: fld('phone') || (prefill?.phone ?? ''),
  document: fld('document') || (prefill?.document ?? ''),
  line1: fld('line1') || (prefill?.line1 ?? ''),
  number: fld('number') || (prefill?.number ?? ''),
  line2: fld('line2') || (prefill?.line2 ?? ''),
  district: fld('district') || (prefill?.district ?? ''),
  city: fld('city') || (prefill?.city ?? ''),
  state: (fld('state') || (prefill?.state ?? '')).toUpperCase(),
  postal: fld('postal') || (prefill?.postal ?? ''),
  // Loja brasileira: entrega só no Brasil.
  country: 'BR',
};

let stage: 'address' | 'shipping' = 'address';
let options: { label: string; amountCents: number; pickup?: boolean }[] = [];
const errors: string[] = [];

// Demo submits itself: the sample address on the first GET, no typing.
const submitted = isPost || rail === 'demo';
if (submitted) {
  if (!/.+@.+\..+/.test(addr.email)) errors.push('Informe um e-mail válido.');
  if (!addr.name) errors.push('Informe o nome completo ou a razão social.');
  if (!telefoneValido(addr.phone)) errors.push('Informe o telefone com DDD.');
  if (!documentoValido(addr.document)) errors.push('CPF ou CNPJ inválido.');
  if (!cepValido(addr.postal)) errors.push('Informe um CEP com 8 dígitos.');
  if (!addr.line1) errors.push('Informe a rua.');
  if (!addr.number) errors.push('Informe o número (use "s/n" se não houver).');
  if (!addr.district) errors.push('Informe o bairro.');
  if (!addr.city) errors.push('Informe a cidade.');
  if (!ufValida(addr.state)) errors.push('Escolha o estado.');

  if (errors.length === 0) {
    // Sem frete configurado (ou pedido sem item físico), a loja não inventa um
    // valor: o pedido segue com "Frete a combinar" e o time fecha a entrega.
    const shippingOn = effectiveShipping.enabled && shipment.shippingRequired;
    // Melhor Envio configurado (token + CEP de origem): cotação real por CEP,
    // com Correios e transportadoras. Tem prioridade sobre as zonas fixas.
    const meToken = shipment.shippingRequired ? await getSecret(env.DB, 'melhorenvio_token') : null;
    const meCep = meToken ? await getSetting(env.DB, 'melhorenvio_cep_origem') : null;
    let meOpcoes: { label: string; amountCents: number }[] | null = null;
    if (meToken && meCep) {
      const semMedida = lines.filter(
        (l) => !(l.product.length_cm && l.product.width_cm && l.product.height_cm) ||
          !(l.variant?.weight_grams ?? l.product.weight_grams),
      );
      // Sem medida/peso cadastrado não há cotação: segue como "Frete a combinar".
      if (semMedida.length === 0) {
        try {
          meOpcoes = await cotarFrete({
            token: meToken,
            sandbox: (await getSetting(env.DB, 'melhorenvio_sandbox')) === '1',
            cepOrigem: meCep,
            cepDestino: addr.postal,
            itens: lines.map((l) => ({
              id: l.product.public_id ?? String(l.product.id),
              comprimento: Number(l.product.length_cm),
              largura: Number(l.product.width_cm),
              altura: Number(l.product.height_cm),
              pesoKg: Number(l.variant?.weight_grams ?? l.product.weight_grams) / 1000,
              valorCents: l.unitPriceCents,
              quantidade: l.qty,
            })),
          });
        } catch (err) {
          console.error(JSON.stringify({ event: 'melhorenvio_quote_failed', message: (err as Error).message }));
          meOpcoes = null; // cai para frete a combinar / zonas
        }
      }
    }
    const quote = meOpcoes && meOpcoes.length
      ? {
          options: meOpcoes,
          omitted: [] as { reason: string }[],
          missingWeight: [] as { name: string; productId: number }[],
          shipmentWeightGrams: shipment.itemWeightGrams ?? null,
        }
      : shippingOn
      ? quoteShipping(effectiveShipping, {
          subtotalCents,
          country: addr.country,
          itemWeightGrams: shipment.itemWeightGrams,
          missingWeight: shipment.missingWeight,
        })
      : {
          options: [{ label: 'Frete a combinar', amountCents: 0 }],
          omitted: [] as { reason: string }[],
          missingWeight: [] as { name: string; productId: number }[],
          shipmentWeightGrams: shipment.itemWeightGrams ?? null,
        };
    options = quote.options;
    if (options.length === 0) {
      // Distinguish "we don't ship there" from "we can't price this basket", so the
      // shopper is told something they can act on.
      const missing = quote.omitted.some((o) => o.reason === 'missing_weight');
      const overweight = quote.omitted.some((o) => o.reason === 'overweight');
      if (missing) {
        console.error(
          JSON.stringify({
            event: 'shipping_quote_blocked',
            reason: 'missing_weight',
            country: addr.country.toUpperCase(),
            products: quote.missingWeight.map(
              (m) => lines.find((l) => l.product.id === m.productId)?.product.public_id ?? m.name,
            ),
          }),
        );
        errors.push(
          `Não conseguimos calcular o frete de ${quote.missingWeight.map((m) => m.name).join(', ')} agora. Fale com a gente para concluir este pedido.`,
        );
      } else if (overweight) {
        errors.push('Este pedido é pesado demais para os fretes disponíveis.');
      } else {
        errors.push('Ainda não entregamos neste endereço. Fale com a gente pelo WhatsApp.');
      }
    } else {
      stage = 'shipping';
      // Demo auto-picks the first rate — the rate step is also skipped.
      const chosenLabel = fld('shipping_label') || (rail === 'demo' ? (options[0]?.label ?? '') : '');
      if (chosenLabel) {
        const chosen = options.find((o) => o.label === chosenLabel);
        if (!chosen) {
          errors.push('Escolha uma opção de frete.');
        } else {
          // Finalize: mint the invoice for subtotal + the chosen shipping.
          // Claim the order's public identity + guest credential BEFORE the
          // provider handoff: the ord_ id ties reservation → pending payment →
          // settled order, and the access token is the only thing guest URLs
          // carry. Reservations keep using the ord_ public id.
          const { publicId, accessToken } = await claimOrderIdentity(env.DB);
          const reservedItems = reservationItems(lines);
          const reservationTtl =
            rail === 'demo'
              ? DEMO_CHECKOUT_TTL_SECONDS
              : rail === 'infinitepay'
                ? 60 * 60 + 5 * 60
                : cfg.payments.lightning.invoiceExpiryMinutes * 60 + 5 * 60;
          const reserved = await reserveInventory(
            env.DB,
            publicId,
            reservedItems,
            reservationTtl,
            rail,
            purgeStockProductCache,
          );
          if (!reserved) {
            await deleteGuestAccessIfUnsettled(env.DB, publicId);
            errors.push('Alguns itens acabaram de esgotar — revise seu carrinho.');
          } else {
            const shippingAddress = {
              name: addr.name,
              line1: addr.line1,
              line2: addr.line2 || null,
              city: addr.city,
              state: addr.state || null,
              postal: formataCep(addr.postal),
              country: addr.country,
              // Campos brasileiros, no mesmo retrato do endereço: a nota fiscal precisa deles.
              number: addr.number,
              district: addr.district,
              document: formataDocumento(addr.document),
              phone: addr.phone,
            };
            const itemsJson = JSON.stringify(
              lines.map((l) => ({ id: l.product.id, v: l.variantId, q: l.qty, n: l.name, p: l.unitPriceCents })),
            );
            try {
              // OpenNode and Demo reach their adapters with the rate ALREADY chosen,
              // so they charge and snapshot the merchant's real configuration
              // instead of ignoring shipping or guessing at the first option.
              if (rail !== 'lightning') {
                const provider = await getPaymentProvider(rail);
                const result = await provider.createCheckout({
                  lineItems: lines.map((l) => ({
                    name: l.name,
                    amountCents: l.unitPriceCents,
                    currency,
                    quantity: l.qty,
                  })),
                  successUrl: `${Astro.url.origin}/order/${accessToken}`,
                  cancelUrl: `${Astro.url.origin}/cart`,
                  orderItemsJson: itemsJson,
                  // Provider metadata NEVER carries the access token.
                  metadata: { public_id: publicId, reservation_id: publicId },
                  accessToken,
                  selectedShipping: {
                    label: chosen.label,
                    amountCents: chosen.amountCents,
                    weightGrams: quote.shipmentWeightGrams,
                    deliveryMethod: chosen.pickup ? 'pickup' : 'shipping',
                    address: shippingAddress,
                    email: addr.email,
                  },
                });
                return Astro.redirect(result.url, 303);
              }
              const minted = await mintLightningOrder(env.DB, await getLightningBackend(), {
                origin: Astro.url.origin,
                publicId,
                accessToken,
                currency,
                subtotalCents,
                shippingCents: chosen.amountCents,
                shippingLabel: chosen.label,
                shippingWeightGrams: quote.shipmentWeightGrams,
                deliveryMethod: chosen.pickup ? 'pickup' : 'shipping',
                itemsJson,
                email: addr.email,
                shippingAddress,
                reservationId: publicId,
              });
              if (!minted.payUrl) throw new Error('Lightning backend did not return a payment URL.');
              return Astro.redirect(minted.payUrl, 303);
            } catch (error) {
              // The Lightning node (e.g. LNbits) can be briefly unreachable. Free
              // the whole claim — held stock AND the guest credential — and show
              // a retryable message instead of a 500, so the shopper can try
              // again or pick another method.
              await releaseInventoryReservation(env.DB, publicId, purgeStockProductCache);
              await deleteGuestAccessIfUnsettled(env.DB, publicId);
              console.error(
                JSON.stringify({
                  event: rail === 'lightning' ? 'lightning_invoice_failed' : 'checkout_create_failed',
                  rail,
                  message: error instanceof Error ? error.message : String(error),
                }),
              );
              errors.push(
                rail === 'lightning'
                  ? 'Lightning indisponível no momento. Tente de novo em instantes.'
                  : 'O pagamento está indisponível no momento. Tente de novo em instantes.',
              );
            }
          }
        }
      }
    }
  }
}

const showShipping = stage === 'shipping';
const hasErrors = errors.length > 0;
---

<Layout title="Finalizar compra" description="Informe os dados de entrega.">
  <div class="mx-auto max-w-lg">
    {
      rail === 'demo' && (
        <div class="mb-6 rounded-lg border-2 border-amber-400 bg-amber-50 px-4 py-4 text-center text-amber-900">
          <p class="text-base font-bold uppercase tracking-wide">⚠️ Pagamento de demonstração — não é um pagamento real</p>
          <p class="mt-1 text-sm">
            Nada é cobrado. Concluir cria um pedido real marcado como
            <code class="rounded bg-amber-100 px-1">demo</code> para você ver o fluxo completo.
          </p>
        </div>
      )
    }
    <h1 class="mb-1 font-serif text-3xl tracking-tight sm:text-4xl">Finalizar compra</h1>
    <p class="mb-6 text-sm text-muted">
      Subtotal {formatPrice(subtotalCents, currency)} · {lines.length} {lines.length === 1 ? 'item' : 'itens'}
    </p>

    {
      hasErrors && (
        <ul class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {errors.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      )
    }

    {
      showShipping ? (
        <form method="POST" action="/checkout" class="space-y-4">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => (
            <input type="hidden" name="extra" value={id} />
          ))}
          <input type="hidden" name="email" value={addr.email} />
          <input type="hidden" name="name" value={addr.name} />
          <input type="hidden" name="phone" value={addr.phone} />
          <input type="hidden" name="document" value={addr.document} />
          <input type="hidden" name="line1" value={addr.line1} />
          <input type="hidden" name="number" value={addr.number} />
          <input type="hidden" name="line2" value={addr.line2} />
          <input type="hidden" name="district" value={addr.district} />
          <input type="hidden" name="city" value={addr.city} />
          <input type="hidden" name="state" value={addr.state} />
          <input type="hidden" name="postal" value={addr.postal} />
          <input type="hidden" name="country" value={addr.country} />

          <div class="rounded-lg border border-line bg-surface p-4 text-sm">
            <div class="mb-1 font-medium">Entregar em</div>
            <div class="text-muted">
              {addr.name} · {formataDocumento(addr.document)}<br />
              {addr.line1}, {addr.number}
              {addr.line2 ? ` — ${addr.line2}` : ''} · {addr.district}<br />
              {addr.city}/{addr.state} · CEP {formataCep(addr.postal)}
            </div>
            <a href={editAddressHref} class="mt-2 inline-block text-xs font-medium text-accent">
              Editar endereço
            </a>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-1 text-sm font-medium">Frete</legend>
            {options.map((o, i) => (
              <label class="flex cursor-pointer items-center justify-between rounded-lg border border-line bg-surface p-3 text-sm has-[:checked]:border-brand">
                <span class="flex items-center gap-2">
                  <input type="radio" name="shipping_label" value={o.label} checked={i === 0} />
                  {o.label}
                </span>
                <span class="text-muted">
                  {o.amountCents === 0 ? (o.label === 'Frete a combinar' ? 'a combinar' : 'Grátis') : formatPrice(o.amountCents, currency)} · total{' '}
                  {formatPrice(subtotalCents + o.amountCents, currency)}
                </span>
              </label>
            ))}
          </fieldset>

          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            {RAIL_LABEL[rail]} →
          </button>
        </form>
      ) : (
        <form method="POST" action="/checkout" class="space-y-3">
          <input type="hidden" name="method" value={rail} />
          <input type="hidden" name="product_id" value={carry} />
          {carryVariantId && <input type="hidden" name="variant_id" value={carryVariantId} />}
          {carryExtraIds.map((id) => (
            <input type="hidden" name="extra" value={id} />
          ))}
          <input type="hidden" name="country" value="BR" />
          <label class="block text-sm">
            <span class="mb-1 block font-medium">E-mail</span>
            <input type="email" name="email" value={addr.email} required autocomplete="email" class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">Nome completo ou razão social</span>
            <input type="text" name="name" value={addr.name} required autocomplete="name" class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">CPF ou CNPJ</span>
              <input type="text" name="document" value={addr.document} required inputmode="numeric" maxlength="18" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Telefone com DDD</span>
              <input type="tel" name="phone" value={addr.phone} required autocomplete="tel" inputmode="tel" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">CEP</span>
              <input type="text" name="postal" value={addr.postal} required inputmode="numeric" maxlength="9" autocomplete="postal-code" data-cep class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <p class="self-end pb-2 text-xs text-faint" data-cep-status></p>
          </div>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">Rua</span>
            <input type="text" name="line1" value={addr.line1} required autocomplete="address-line1" data-cep-rua class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <div class="grid grid-cols-3 gap-3">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Número</span>
              <input type="text" name="number" value={addr.number} required class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="col-span-2 block text-sm">
              <span class="mb-1 block font-medium">Complemento (opcional)</span>
              <input type="text" name="line2" value={addr.line2} autocomplete="address-line2" class="w-full rounded-md border border-line px-3 py-2" />
            </label>
          </div>
          <label class="block text-sm">
            <span class="mb-1 block font-medium">Bairro</span>
            <input type="text" name="district" value={addr.district} required data-cep-bairro class="w-full rounded-md border border-line px-3 py-2" />
          </label>
          <div class="grid grid-cols-3 gap-3">
            <label class="col-span-2 block text-sm">
              <span class="mb-1 block font-medium">Cidade</span>
              <input type="text" name="city" value={addr.city} required autocomplete="address-level2" data-cep-cidade class="w-full rounded-md border border-line px-3 py-2" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">Estado</span>
              <select name="state" required data-cep-uf class="w-full rounded-md border border-line bg-surface px-3 py-2">
                <option value="">UF</option>
                {UFS.map((uf) => (
                  <option value={uf} selected={uf === addr.state}>{uf}</option>
                ))}
              </select>
            </label>
          </div>
          <button
            type="submit"
            class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-on-brand hover:bg-brand-hover"
          >
            Continuar para o frete →
          </button>
        </form>
      )
    }
  </div>
  <script>
    // Preenche rua, bairro, cidade e estado a partir do CEP (ViaCEP). Só ajuda:
    // sem JavaScript o formulário continua funcionando.
    const cep = document.querySelector<HTMLInputElement>('[data-cep]');
    const status = document.querySelector<HTMLElement>('[data-cep-status]');
    const preenche = (sel: string, v: string) => {
      const el = document.querySelector<HTMLInputElement | HTMLSelectElement>(sel);
      if (el && v && !el.value) el.value = v;
    };
    let ultimo = '';
    cep?.addEventListener('input', async () => {
      const d = cep.value.replace(/\D+/g, '');
      if (d.length !== 8 || d === ultimo) return;
      ultimo = d;
      if (status) status.textContent = 'Buscando endereço…';
      try {
        const r = await fetch(`https://viacep.com.br/ws/${d}/json/`);
        const j = await r.json();
        if (j.erro) throw new Error('cep');
        preenche('[data-cep-rua]', j.logradouro);
        preenche('[data-cep-bairro]', j.bairro);
        preenche('[data-cep-cidade]', j.localidade);
        preenche('[data-cep-uf]', j.uf);
        if (status) status.textContent = '';
        document.querySelector<HTMLInputElement>('input[name="number"]')?.focus();
      } catch {
        if (status) status.textContent = 'CEP não encontrado — preencha à mão.';
      }
    });
  </script>
</Layout>
