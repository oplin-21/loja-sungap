---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPages } from '../../../features/pages/db';
import { menuReferencesFor } from '../../../features/navigation/admin';

const pages = await listPages(env.DB);
// Deleting a page that a menu links to silently shrinks the storefront nav.
// One bounded query for the whole list, so say so before it happens.
const menuRefs = await menuReferencesFor(
  env.DB,
  'page',
  pages.map((p) => p.id),
);
const dateFmt = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'medium' });
const formatDate = (iso: string) => dateFmt.format(new Date(`${iso.replace(' ', 'T')}Z`));
---

<AdminLayout title="Páginas" active="pages">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">Páginas</h1>
    <a
      href="/admin/pages/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      Nova página
    </a>
  </div>

  {
    pages.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        No pages yet. Create one for About, Shipping, Returns, or Privacy, then add it to your
        {' '}
        <a href="/admin/navigation" class="underline hover:text-brand">
          navigation
        </a>{' '}
        so shoppers can find it.
      </p>
    ) : (
      <div class="sm:overflow-x-auto">
        <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
          <thead>
            <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
              <th class="py-3 pr-4 font-normal">Título</th>
              <th class="py-3 pr-4 font-normal">Link</th>
              <th class="py-3 pr-4 font-normal">Situação</th>
              <th class="py-3 pr-4 font-normal">Atualizado</th>
              <th class="py-3 text-right font-normal">Ações</th>
            </tr>
          </thead>
          <tbody>
            {pages.map((page) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4">
                  <a href={`/admin/pages/${page.public_id}/edit`} class="font-medium hover:text-brand">
                    {page.title}
                  </a>
                </td>
                <td data-label="Link" class="py-3 pr-4 text-gray-500">/pages/{page.slug}</td>
                <td data-label="Situação" class="py-3 pr-4">
                  {page.published ? (
                    <span class="text-gray-600">Publicada</span>
                  ) : (
                    <span class="text-gray-400">Rascunho</span>
                  )}
                </td>
                <td data-label="Updated" class="py-3 pr-4 text-gray-500">
                  {formatDate(page.updated_at)}
                </td>
                <td class="py-3 text-right">
                  <span class="inline-flex items-center gap-3">
                    {page.published !== 0 && (
                      <a
                        href={`/pages/${page.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                      >
                        Ver
                      </a>
                    )}
                    <a
                      href={`/admin/pages/${page.public_id}/edit`}
                      class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                    >
                      Editar
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/pages/${page.public_id}`}
                      onsubmit={`return confirm('${
                        menuRefs.has(page.id)
                          ? 'This page is linked from your navigation. Deleting it hides that link on the storefront. Continue?'
                          : 'Delete this page?'
                      }')`}
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        Excluir
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
