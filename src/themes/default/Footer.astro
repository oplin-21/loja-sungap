---
import type { StorefrontShellModel } from '../../features/storefront/models';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * Footer links come from the merchant's navigation menu, already filtered to
 * targets that are actually publishable, so nothing here can render a dead
 * link. Like the header, this renders on every page.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

<footer class="bg-brand text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 text-sm md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-4">
      <img src="/marca/logo-sungap-claro.webp" alt="Sungap" width="140" height="46" loading="lazy" class="h-10 w-auto self-start" />
      <p class="max-w-xs leading-relaxed text-white/80">Ombrelone, guarda-sol e cadeira de praia personalizados, com fabricação própria.</p>
    </div>
    <div>
      <p class="mb-4 font-serif text-xs font-bold uppercase tracking-widest">Produtos</p>
      <ul class="flex flex-col gap-2.5 text-white/80">
        {model.headerLinks.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.text}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-4 font-serif text-xs font-bold uppercase tracking-widest">Institucional</p>
      <ul class="flex flex-col gap-2.5 text-white/80">
        <li><a href="/" class="hover:text-white">Início</a></li>
        <li><a href="https://www.sungap.com.br" class="hover:text-white">Site Sungap</a></li>
        {model.footerLinks.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.text}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-4 font-serif text-xs font-bold uppercase tracking-widest">Contato</p>
      <address class="flex flex-col gap-2.5 not-italic text-white/80">
        <span>Rua Islândia, 280<br />Parque Industrial Daci · Taboão da Serra/SP</span>
        <span>CNPJ 29.640.033/0001-88</span>
      </address>
    </div>
  </div>
  <div class="mx-auto max-w-6xl border-t border-white/15 px-6 py-6">
    <div class="flex items-center justify-center gap-4">
      <span class="font-serif text-xs font-bold uppercase tracking-widest text-white/80">Empresa do</span>
      {/* Logotipo do grupo em branco sobre o azul Sungap. */}
      <img src="/marca/logo-oplin.webp" alt="Grupo Oplin" width="150" height="50" loading="lazy" class="h-10 w-auto brightness-0 invert" />
    </div>
    <p class="mt-4 text-center text-xs text-white/60">&copy; {new Date().getFullYear()} {model.storeName}</p>
  </div>
</footer>
